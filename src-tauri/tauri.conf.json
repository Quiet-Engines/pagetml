{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PageTML",
  "version": "0.1.0",
  "identifier": "app.quietengines.pagetml",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5179",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": false }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/content-runtime.js"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["html", "htm"],
        "name": "HTML Document",
        "description": "HTML document opened in PageTML",
        "role": "Viewer"
      }
    ]
  }
}
